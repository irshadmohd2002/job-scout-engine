# Copy to .env and fill in real values. Never commit .env.

# --- Adzuna (public API, Milestone 1) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Anthropic API (OPTIONAL — only used for Stage 4 LLM enrichment, post-M1) ---
# Leave unset to run the engine in fully deterministic mode.
# Do not hard-code a model ID anywhere in code; it is always read from here.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Notifications (email channel, post local-vertical-slice) ---
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USERNAME=
NOTIFY_SMTP_PASSWORD=
NOTIFY_FROM_ADDRESS=
NOTIFY_TO_ADDRESS=

# --- Paths (Milestone 1.1 — see architecture.md section 15.1) ---
# Both optional. Leave unset to use the platform-appropriate per-user data
# directory (via platformdirs) that `job-scout init` creates for you.
# JOB_SCOUT_DATA_DIR=/path/to/your/own/data/directory
# JOB_SCOUT_DB_PATH overrides only the database file, independent of
# JOB_SCOUT_DATA_DIR — usually leave both unset.
JOB_SCOUT_DB_PATH=

# --- Runtime ---
LOG_LEVEL=INFO
