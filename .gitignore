# Personal, machine-specific Claude Code settings — never shared/committed.
# Do NOT ignore the whole .claude/ directory: it may later hold
# project-shared config (e.g. settings.json, custom commands) that should
# be tracked.
.claude/settings.local.json

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.env
*.db
*.sqlite
*.sqlite3
data/
dist/
build/
*.egg-info/
.vscode/
.idea/

# Milestone 1.1: real config/database/logs/cache live in the per-user data
# directory resolved by AppPaths (platformdirs), outside this repository —
# see decisions.md D-018/D-021. Nothing under config/ is tracked or
# generated here any more (config/*.example.yaml was replaced by the
# packaged templates under src/job_scout/resources/templates/). Kept as a
# defensive ignore in case a local dev workflow points --data-dir at a
# directory inside the repo.
config/
